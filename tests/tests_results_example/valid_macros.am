; Valid input demonstrating ordinary, repeated and empty macros
.entry MAIN
.entry MESSAGE
.extern PRINTTEXT




MAIN: ori $0,10,$1
add $1,$2,$3
subi $3,1,$3
add $1,$2,$3
subi $3,1,$3
la MESSAGE
call PRINTTEXT
beq $3,$0,DONE
jmp MAIN
DONE: hlt

MESSAGE: .asciz "Macro expansion works"
VALUES: .dw 10,20,30
